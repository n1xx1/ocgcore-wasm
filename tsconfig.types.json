{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "types": ["node", "emscripten"]
  },
  "include": ["./src/**/*"]
}
